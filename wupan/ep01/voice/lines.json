[
 {
  "id": "001",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "和所有动物一样，人类也有底层代码。",
  "takes": 1
 },
 {
  "id": "002",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "这些代码大多时候很好用，帮我们飞快做出选择；代价是，它常常让我们在不知不觉中犯错。",
  "takes": 1
 },
 {
  "id": "003",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "科学家最早在社会性昆虫身上发现了这一点，比如蚂蚁。",
  "takes": 1
 },
 {
  "id": "004",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "蚂蚁死后，尸体会散发一种特殊的气味。其他蚂蚁一闻到，就叫上同伴，把尸体抬出巢穴。",
  "takes": 1
 },
 {
  "id": "005",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "这套程序是神经系统设定好的，一般十分实用。",
  "takes": 1
 },
 {
  "id": "006",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "可如果你把这种气味，涂到一只活蚂蚁身上，有意思的一幕就发生了。",
  "takes": 1
 },
 {
  "id": "007",
  "role": "蚂蚁A",
  "voice": "G1 周杰伦",
  "voice_id": "1512d05841734931bf905d0520c272b1",
  "model": "drama-3",
  "text": "[语气轻松欢快，像跟熟人打招呼]嗨，兄弟，今儿怎么样？",
  "takes": 1
 },
 {
  "id": "008",
  "role": "蚂蚁B",
  "voice": "G3 白岩松",
  "voice_id": "85d573e7dfca4426816d5444100786ae",
  "model": "drama-3",
  "text": "[一本正经，像在宣布一件严肃的事]你好像有点死了。来人啊。",
  "takes": 1
 },
 {
  "id": "009",
  "role": "蚂蚁A",
  "voice": "G1 周杰伦",
  "voice_id": "1512d05841734931bf905d0520c272b1",
  "model": "drama-3",
  "text": "[惊恐地尖叫]啊？？？等等，我还活着啊！",
  "takes": 1
 },
 {
  "id": "010",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "就这样，一只好好的活蚂蚁，连踢带挣扎，被扔出了巢穴。",
  "takes": 1
 },
 {
  "id": "011",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "蚂蚁的大脑就是这样，很多时候，只会照着程序做机械反应。",
  "takes": 1
 },
 {
  "id": "012",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "人类的大脑里，也有很多这样过度简化的程序。它们注定了，我们的大脑会经常出事故。",
  "takes": 1
 },
 {
  "id": "014",
  "role": "讲述人",
  "voice": "T1 猫猫2",
  "voice_id": "2c0b44c053ed40788650a9d9d90d1f20",
  "model": "s2.1-pro",
  "text": "有一天，心理学家西奥迪尼，接到一个朋友的电话。她在亚利桑那州，刚开了一家印第安珠宝店。",
  "takes": 1
 },
 {
  "id": "015",
  "role": "店主",
  "voice": "D2 卡提西亚",
  "voice_id": "30ad478e008b4142babab2675dac1834",
  "model": "drama-3",
  "text": "[兴奋，压低声音，像在电话里分享八卦]哎，你是心理学家，你帮我解释解释，我碰到一件怪事！",
  "takes": 2
 },
 {
  "id": "016",
  "role": "店主",
  "voice": "D2 卡提西亚",
  "voice_id": "30ad478e008b4142babab2675dac1834",
  "model": "drama-3",
  "text": "[絮絮叨叨地抱怨]我店里有一批绿松石首饰，怎么都卖不掉。现在正是旺季，客人多得很，货也不差，价格也公道。",
  "takes": 2
 },
 {
  "id": "017",
  "role": "店主",
  "voice": "D2 卡提西亚",
  "voice_id": "30ad478e008b4142babab2675dac1834",
  "model": "drama-3",
  "text": "[无奈]我把它们挪到最显眼的中央展台，又让店员使劲推销，都没用。",
  "takes": 2
 },
 {
  "id": "018",
  "role": "店主",
  "voice": "D2 卡提西亚",
  "voice_id": "30ad478e008b4142babab2675dac1834",
  "model": "drama-3",
  "text": "后来我要出差采购，走之前给店员留了张字条，写得特别潦草：",
  "takes": 2
 },
 {
  "id": "019",
  "role": "店主",
  "voice": "D2 卡提西亚",
  "voice_id": "30ad478e008b4142babab2675dac1834",
  "model": "drama-3",
  "text": "[匆忙，边写边念]这个柜里所有东西，价格，乘以二分之一。",
  "takes": 2
 },
 {
  "id": "020",
  "role": "店主",
  "voice": "D2 卡提西亚",
  "voice_id": "30ad478e008b4142babab2675dac1834",
  "model": "drama-3",
  "text": "[叹气]我想的是，亏本也要清掉。",
  "takes": 2
 },
 {
  "id": "021",
  "role": "店主",
  "voice": "D2 卡提西亚",
  "voice_id": "30ad478e008b4142babab2675dac1834",
  "model": "drama-3",
  "text": "[激动起来]结果你猜怎么着？我回来一看，全卖光了！[pause]店员把我写的“二分之一”，看成了“二”！",
  "takes": 2
 },
 {
  "id": "022",
  "role": "店主",
  "voice": "D2 卡提西亚",
  "voice_id": "30ad478e008b4142babab2675dac1834",
  "model": "drama-3",
  "text": "[难以置信]全都是按两倍的价格卖出去的！",
  "takes": 2
 },
 {
  "id": "022b",
  "role": "讲述人",
  "voice": "T1 猫猫2",
  "voice_id": "2c0b44c053ed40788650a9d9d90d1f20",
  "model": "s2.1-pro",
  "text": "西奥迪尼听完，笑了。",
  "takes": 1
 },
 {
  "id": "023",
  "role": "西奥迪尼",
  "voice": "G4 柯南",
  "voice_id": "2be01e35836944349cb569863173e6c9",
  "model": "drama-3",
  "text": "[平静，像在跟老朋友聊天]你想啊，那些游客，从小就信一分钱一分货。这条规则一次次被验证，慢慢就简化成了：贵，就等于好。",
  "takes": 2
 },
 {
  "id": "024",
  "role": "西奥迪尼",
  "voice": "G4 柯南",
  "voice_id": "2be01e35836944349cb569863173e6c9",
  "model": "drama-3",
  "text": "[平静，娓娓道来]他们想买好的绿松石，自己又看不懂，那就只能看价格。你标得越贵，他们就越觉得，这是好东西。",
  "takes": 2
 },
 {
  "id": "026",
  "role": "讲述人",
  "voice": "T1 猫猫2",
  "voice_id": "2c0b44c053ed40788650a9d9d90d1f20",
  "model": "s2.1-pro",
  "text": "经济学家艾瑞里，有一次在《经济学人》的网站上，看到一则订阅广告。",
  "takes": 1
 },
 {
  "id": "027",
  "role": "艾瑞里",
  "voice": "C2 短剧解说",
  "voice_id": "6758b6fa79384cffae6f4adea4b5cc65",
  "model": "drama-3",
  "text": "[边看边念]网络版，五十九美元。印刷版，一百二十五美元。印刷版加网络版，还是一百二十五美元？",
  "takes": 2
 },
 {
  "id": "028",
  "role": "艾瑞里",
  "voice": "C2 短剧解说",
  "voice_id": "6758b6fa79384cffae6f4adea4b5cc65",
  "model": "drama-3",
  "text": "[困惑，忍不住吐槽]等一下。花同样的钱，能买到两样，谁会只买印刷版啊？",
  "takes": 2
 },
 {
  "id": "028b",
  "role": "艾瑞里",
  "voice": "C2 短剧解说",
  "voice_id": "6758b6fa79384cffae6f4adea4b5cc65",
  "model": "drama-3",
  "text": "[恍然大悟，压低声音]不对，人家营销的人不傻。这个没人要的选项摆在这儿，就是为了让旁边的套餐，看起来特别划算。",
  "takes": 2
 },
 {
  "id": "028c",
  "role": "艾瑞里",
  "voice": "C2 短剧解说",
  "voice_id": "6758b6fa79384cffae6f4adea4b5cc65",
  "model": "drama-3",
  "text": "[来了兴致]那我倒要试试，一个“没用”的选项，到底能把人推多远。",
  "takes": 2
 },
 {
  "id": "029",
  "role": "讲述人",
  "voice": "T1 猫猫2",
  "voice_id": "2c0b44c053ed40788650a9d9d90d1f20",
  "model": "s2.1-pro",
  "text": "他找来一百个管理学院的学生，让他们从这三个选项里选。",
  "takes": 1
 },
 {
  "id": "030",
  "role": "讲述人",
  "voice": "T1 猫猫2",
  "voice_id": "2c0b44c053ed40788650a9d9d90d1f20",
  "model": "s2.1-pro",
  "text": "结果，网络版十六人，印刷版零人，套餐八十四人。",
  "takes": 1
 },
 {
  "id": "031",
  "role": "讲述人",
  "voice": "T1 猫猫2",
  "voice_id": "2c0b44c053ed40788650a9d9d90d1f20",
  "model": "s2.1-pro",
  "text": "接着，他把那个没人选的印刷版拿掉，换另一批学生再选一次。[pause]网络版变成了六十八人，套餐只剩三十二人。",
  "takes": 1
 },
 {
  "id": "032",
  "role": "艾瑞里",
  "voice": "C2 短剧解说",
  "voice_id": "6758b6fa79384cffae6f4adea4b5cc65",
  "model": "drama-3",
  "text": "[认真，像在点破一件事]网络版和套餐，哪个更值？不好比。可套餐和印刷版一个价，一比就知道：套餐赚了。",
  "takes": 2
 },
 {
  "id": "033",
  "role": "艾瑞里",
  "voice": "C2 短剧解说",
  "voice_id": "6758b6fa79384cffae6f4adea4b5cc65",
  "model": "drama-3",
  "text": "[轻轻一笑]所以大家不是在选最好的，[pause]是在选最好比的。",
  "takes": 2
 },
 {
  "id": "034",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "人类有很多认知倾向，总体很有用，却经常出错。不加提防，不仅会在生活和事业上犯大错，还会被别人故意操纵。",
  "takes": 1
 },
 {
  "id": "035",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "这就是芒格所说的“人类误判心理学”。这样的心理误差，足足有二十五种。",
  "takes": 1
 },
 {
  "id": "036",
  "role": "主旁白",
  "voice": "B8 蒋介石",
  "voice_id": "918a8277663d476b95e2c4867da0f6a6",
  "model": "s2.1-pro",
  "text": "了解它们，能让你想得更清楚，也能让你不被别人控制。所以，快来学习吧。",
  "takes": 1
 }
]