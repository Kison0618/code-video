{
  "_说明": "全片文案（115 句）。text 里用 {花括号} 标出字幕里要变色的关键词；对齐配音时会自动去掉标点和花括号。顺序不能改，id 被画面代码引用。",
  "lines": [
    {"id": "a1",  "ch": "开场", "text": "这部短片，会骗你{两次}"},
    {"id": "a2",  "ch": "开场", "text": "第一次，{已经开始}了"},
    {"id": "a3",  "ch": "男孩", "text": "这是一个男孩的房间"},
    {"id": "a4",  "ch": "男孩", "text": "他七岁"},
    {"id": "a5",  "ch": "男孩", "text": "这艘{小船}"},
    {"id": "a6",  "ch": "男孩", "text": "是爸爸用木头给他做的"},
    {"id": "a7",  "ch": "男孩", "text": "他逢人就说"},
    {"id": "a8",  "ch": "男孩", "text": "我长大了，要当{船长}"},
    {"id": "a9",  "ch": "男孩", "text": "我这辈子，就喜欢海"},
    {"id": "a10", "ch": "男孩", "text": "你先别笑他"},
    {"id": "a11", "ch": "男孩", "text": "这种话，你也说过"},
    {"id": "a12", "ch": "男孩", "text": "“我就是这样的人。”"},
    {"id": "a13", "ch": "男孩", "text": "“我这人，就这脾气。”"},
    {"id": "a14", "ch": "男孩", "text": "“改不了。”"},

    {"id": "b1",  "ch": "第一次", "text": "好，现在说第一次骗你的事"},
    {"id": "b2",  "ch": "第一次", "text": "不是那片海"},
    {"id": "b3",  "ch": "第一次", "text": "是{这个房间}"},
    {"id": "b4",  "ch": "第一次", "text": "从你点开到现在"},
    {"id": "b5",  "ch": "第一次", "text": "它被换掉了{九样}东西"},
    {"id": "b6",  "ch": "第一次", "text": "墙、窗帘、被子、地毯、画、台灯、椅子、小熊"},
    {"id": "b7",  "ch": "第一次", "text": "还有他身上那件衣服"},
    {"id": "b8",  "ch": "第一次", "text": "你发现了{几样}？"},
    {"id": "b9",  "ch": "第一次", "text": "没发现，不怪你"},
    {"id": "b10", "ch": "第一次", "text": "因为它不是一下子换的"},
    {"id": "b11", "ch": "第一次", "text": "是{一点一点}换的"},
    {"id": "b12", "ch": "第一次", "text": "变化只要够慢，人就{看不见}"},
    {"id": "b13", "ch": "第一次", "text": "你这个人，也是这样被{换掉}的"},

    {"id": "c1",  "ch": "岁月", "text": "十七岁"},
    {"id": "c2",  "ch": "岁月", "text": "船长的画，换成了乐队"},
    {"id": "c3",  "ch": "岁月", "text": "二十七岁"},
    {"id": "c4",  "ch": "岁月", "text": "床换了，多了一个人"},
    {"id": "c5",  "ch": "岁月", "text": "三十七岁"},
    {"id": "c6",  "ch": "岁月", "text": "多了一张小床"},
    {"id": "c7",  "ch": "岁月", "text": "五十七岁"},
    {"id": "c8",  "ch": "岁月", "text": "小床早就没了，墙刷过三遍"},
    {"id": "c9",  "ch": "岁月", "text": "七十七岁"},
    {"id": "c10", "ch": "岁月", "text": "这个房间里，原来的东西"},
    {"id": "c11", "ch": "岁月", "text": "只剩{那艘船}"},

    {"id": "d1",  "ch": "船", "text": "可那艘船"},
    {"id": "d2",  "ch": "船", "text": "桅杆断过，{换了}"},
    {"id": "d3",  "ch": "船", "text": "帆破过，{换了}"},
    {"id": "d4",  "ch": "船", "text": "船底裂过，补了块{新木头}"},
    {"id": "d5",  "ch": "船", "text": "它也早就{不是原来}那一艘"},
    {"id": "d6",  "ch": "船", "text": "两千年前，希腊人就为这事吵过"},
    {"id": "d7",  "ch": "船", "text": "一艘船，木板一块一块全换掉"},
    {"id": "d8",  "ch": "船", "text": "它还是{原来那艘船}吗？"},

    {"id": "e1",  "ch": "一个晚上", "text": "先帮我记住一个晚上"},
    {"id": "e2",  "ch": "一个晚上", "text": "床、枕头、被子、哈欠、犯困、熄灯、晚安、做梦、打呼"},
    {"id": "e3",  "ch": "一个晚上", "text": "记住了？先放着"},

    {"id": "f1",  "ch": "身体", "text": "现在，把那艘船换成{你}"},
    {"id": "f2",  "ch": "身体", "text": "你的胃壁，{几天}换一层"},
    {"id": "f3",  "ch": "身体", "text": "皮肤，{一个月}"},
    {"id": "f4",  "ch": "身体", "text": "血，{四个月}"},
    {"id": "f5",  "ch": "身体", "text": "骨头，{十年}"},
    {"id": "f6",  "ch": "身体", "text": "换下来的旧零件"},
    {"id": "f7",  "ch": "身体", "text": "早够{再拼一个你}"},
    {"id": "f8",  "ch": "身体", "text": "也有不肯换的"},
    {"id": "f9",  "ch": "身体", "text": "大脑里的{神经细胞}"},
    {"id": "f10", "ch": "身体", "text": "大多陪你{一辈子}"},
    {"id": "f11", "ch": "身体", "text": "那“{你}”，总该住在那儿吧？"},
    {"id": "f12", "ch": "身体", "text": "那里存着你的记忆"},
    {"id": "f13", "ch": "身体", "text": "记忆，总是{原装}的吧？"},

    {"id": "g1",  "ch": "第二次", "text": "回到刚才那个晚上"},
    {"id": "g2",  "ch": "第二次", "text": "那一串词里"},
    {"id": "g3",  "ch": "第二次", "text": "有没有“{睡觉}”？"},
    {"id": "g4",  "ch": "第二次", "text": "{没有}"},
    {"id": "g5",  "ch": "第二次", "text": "床、枕头、做梦、打呼都有"},
    {"id": "g6",  "ch": "第二次", "text": "偏偏没有“{睡觉}”"},
    {"id": "g7",  "ch": "第二次", "text": "这是{第二次}骗你"},
    {"id": "g8",  "ch": "第二次", "text": "这个实验，心理学家做了三十年"},
    {"id": "g9",  "ch": "第二次", "text": "{大多数}人都说有"},
    {"id": "g10", "ch": "第二次", "text": "那个词，是你的大脑{自己放进去}的"},
    {"id": "g11", "ch": "第二次", "text": "它不是把那个晚上取出来"},
    {"id": "g12", "ch": "第二次", "text": "是拿几块碎片，{现拼}了一个"},
    {"id": "g13", "ch": "第二次", "text": "你记得的每一件往事"},
    {"id": "g14", "ch": "第二次", "text": "都是这样拼出来的"},
    {"id": "g15", "ch": "第二次", "text": "每想起一次，就{重拼一次}"},
    {"id": "g16", "ch": "第二次", "text": "你最常回忆的那一天"},
    {"id": "g17", "ch": "第二次", "text": "被改的机会也{最多}"},

    {"id": "h1",  "ch": "我", "text": "东西换了。身体换了"},
    {"id": "h2",  "ch": "我", "text": "记忆也改了"},
    {"id": "h3",  "ch": "我", "text": "那总还剩一个“{我}”吧？"},
    {"id": "h4",  "ch": "我", "text": "我的脾气，我的喜好"},
    {"id": "h5",  "ch": "我", "text": "我是什么样的人"},
    {"id": "h6",  "ch": "我", "text": "心理学家问过{一万九千}人"},
    {"id": "h7",  "ch": "我", "text": "每个年纪的人都说"},
    {"id": "h8",  "ch": "我", "text": "过去十年，我{变了好多}"},
    {"id": "h9",  "ch": "我", "text": "每个年纪的人又都说"},
    {"id": "h10", "ch": "我", "text": "往后十年，我{不会怎么变}了"},
    {"id": "h11", "ch": "我", "text": "十八岁这么说"},
    {"id": "h12", "ch": "我", "text": "六十八岁，还这么说"},
    {"id": "h13", "ch": "我", "text": "人人都觉得"},
    {"id": "h14", "ch": "我", "text": "自己刚好活成了{最终版}"},
    {"id": "h15", "ch": "我", "text": "“我就是这样的人”"},
    {"id": "h16", "ch": "我", "text": "七岁说过，十七岁说过"},
    {"id": "h17", "ch": "我", "text": "五十七岁也说过"},
    {"id": "h18", "ch": "我", "text": "{没有一次}说对"},

    {"id": "i1",  "ch": "接力", "text": "那你到底是什么？"},
    {"id": "i2",  "ch": "接力", "text": "你看这一排人"},
    {"id": "i3",  "ch": "接力", "text": "哪一个，才是真正的他？"},
    {"id": "i4",  "ch": "接力", "text": "{都不是}"},
    {"id": "i5",  "ch": "接力", "text": "可是七岁的他"},
    {"id": "i6",  "ch": "接力", "text": "把船交给了十七岁的他"},
    {"id": "i7",  "ch": "接力", "text": "十七岁，交给二十七岁"},
    {"id": "i8",  "ch": "接力", "text": "一个交给一个，{一直交到今天}"},
    {"id": "i9",  "ch": "接力", "text": "你{不是一个人}"},
    {"id": "i10", "ch": "接力", "text": "你是一场{接力}"},

    {"id": "j1",  "ch": "结尾", "text": "所以，别再为十年前"},
    {"id": "j2",  "ch": "结尾", "text": "那个丢人的自己睡不着了"},
    {"id": "j3",  "ch": "结尾", "text": "他已经{交棒}了"},
    {"id": "j4",  "ch": "结尾", "text": "也别替十年后的你，把话说死"},
    {"id": "j5",  "ch": "结尾", "text": "接棒的那个人，你{还不认识}"},
    {"id": "j6",  "ch": "结尾", "text": "你能做的只有一件事"},
    {"id": "j7",  "ch": "结尾", "text": "跑好手里{这一棒}"},
    {"id": "j8",  "ch": "结尾", "text": "把一样好东西，{递过去}"}
  ]
}
